---
import ComingSoon from './ComingSoon.astro';
import Hero from './Hero.astro';
import CaminoSection from './CaminoSection.astro';
import CapabilitiesTour from './CapabilitiesTour.astro';
import PlatformTour from './PlatformTour.astro';
import MvpSection from './MvpSection.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Label from './ui/Label.astro';
import Button from './ui/Button.astro';
import { site } from '../config/site';
import { t } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

const home = localizedPath('home', locale);
const base = home === '/' ? '' : home;

/* Interruptor de publicación: con PUBLIC_COMING_SOON=1 solo se muestra el aviso. */
const comingSoon = import.meta.env.PUBLIC_COMING_SOON === '1';
---

{comingSoon && <ComingSoon locale={locale} />}

{!comingSoon && (
<>

<Hero locale={locale} />

<CaminoSection locale={locale} />

<MvpSection locale={locale} />

<!-- ── Capacidades: recorrido con texto y pantalla del mismo peso, y el bloque de Power Platform ── -->
<section id="servicios" class="border-b border-line">
  <div class="container-page py-24 sm:py-28">
    <SectionHeader label={strings.cap.eyebrow} title={strings.cap.title} lead={strings.cap.subtitle} />
    <CapabilitiesTour locale={locale} />

    <div id="power-platform" class="mt-28 border-t border-line pt-20">
      <Label>{strings.plat.eyebrow}</Label>
      <h3 class="h-title mt-3 max-w-4xl">{strings.plat.title}</h3>
      <p class="mt-5 max-w-3xl text-lead text-body">{strings.plat.lead}</p>
      <PlatformTour locale={locale} />
      <div class="tx">
        <div class="callout">
          <span class="ic" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"></path></svg>
          </span>
          <p>{strings.plat.closing}</p>
          <Button href={`${base}/#contacto`} variant="secondary">{strings.nav.contact}</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── Nosotros ─────────────────────────────────────────────────────────── -->
<section id="nosotros" class="border-b border-line bg-canvas-soft">
  <div class="container-page py-24 sm:py-32">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <SectionHeader class="reveal" label={strings.about.eyebrow} title={strings.about.title} />
      <div class="reveal space-y-6 text-lead text-body" style="--d:.08s">
        <p class="h-sub !mt-0">{strings.about.lead}</p>
        {strings.about.body.map((paragraph) => <p>{paragraph}</p>)}
        <blockquote class="quote mt-10 border-l-2 border-clay pl-6">
          {strings.about.quote}
        </blockquote>
      </div>
    </div>
  </div>
</section>

<!-- ── Contacto ─────────────────────────────────────────────────────────── -->
<section id="contacto" class="theme-ink bg-canvas">
  <div class="container-page py-24 sm:py-32">
    <div class="grid gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-24">
      <div class="reveal">
        <h2 class="h-title text-strong">{strings.contact.title}</h2>
        <p class="mt-7 max-w-lg text-lead text-body">{strings.contact.subtitle}</p>
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
          <Button href={`mailto:${site.email.general}`} size="lg">{strings.contact.cta}</Button>
          <a
            href={`${base}/#mvp`}
            class="inline-block py-3 text-sm font-medium text-body underline decoration-line-strong underline-offset-[6px] transition-colors hover:text-strong hover:decoration-signal"
          >
            {strings.contact.mvpHint}
          </a>
        </div>
      </div>

      <dl class="reveal grid gap-0 self-end border-t border-line-strong" style="--d:.1s">
        <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[8rem_1fr] sm:items-baseline">
          <dt class="label">{strings.contact.emailLabel}</dt>
          <dd>
            <a
              href={`mailto:${site.email.general}`}
              class="break-all text-base text-strong underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-signal"
            >
              {site.email.general}
            </a>
          </dd>
        </div>
        <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[8rem_1fr] sm:items-baseline">
          <dt class="label">{strings.contact.phoneLabel}</dt>
          <dd class="text-base text-strong">{site.phone}</dd>
        </div>
        <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[8rem_1fr] sm:items-baseline">
          <dt class="label">{strings.contact.locationLabel}</dt>
          <dd class="text-base text-strong">{site.address.city}, {site.address.country}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

</>
)}
