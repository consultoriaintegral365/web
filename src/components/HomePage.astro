---
import { site } from '../config/site';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

/* Un icono por servicio, en el mismo orden que ui.ts. Son trazos SVG
   inline: sin peticiones extra ni dependencias de iconos. */
const serviceIcons = [
  'M3 3v18h18M7 15l3.5-4 3 3L21 7', // analítica: línea de tendencia
  'M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6l2.1 2.1m0-12.8l-2.1 2.1M7.7 16.3l-2.1 2.1M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0', // automatización: engranaje
  'M8 6l-5 6 5 6M16 6l5 6-5 6M13.5 4l-3 16', // desarrollo: código
  'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z', // Microsoft: cuadrantes
];
---

<!-- ── Hero ─────────────────────────────────────────────────────────────── -->
<section class="relative overflow-hidden border-b border-ink-100 bg-ink-50">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(60rem_30rem_at_70%_-10%,var(--color-brand-100),transparent)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative py-20 sm:py-28">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand-700">
        {strings.hero.eyebrow}
      </p>
      <h1 class="mt-5 text-4xl font-bold leading-[1.1] sm:text-5xl lg:text-6xl">
        {strings.hero.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-600">
        {strings.hero.subtitle}
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#contacto" class="btn-primary">{strings.hero.ctaPrimary}</a>
        <a href="#servicios" class="btn-secondary">{strings.hero.ctaSecondary}</a>
      </div>
    </div>
  </div>
</section>

<!-- ── Servicios ────────────────────────────────────────────────────────── -->
<section id="servicios" class="container-page scroll-mt-24 py-20 sm:py-24">
  <div class="max-w-2xl">
    <h2 class="text-3xl font-bold sm:text-4xl">{strings.services.title}</h2>
    <p class="mt-4 text-lg text-ink-600">{strings.services.subtitle}</p>
  </div>

  <ul class="mt-12 grid gap-6 sm:grid-cols-2">
    {
      strings.services.items.map((item, i) => (
        <li class="rounded-2xl border border-ink-100 bg-white p-7 transition-colors hover:border-brand-200">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={serviceIcons[i]} />
            </svg>
          </span>
          <h3 class="mt-5 text-lg font-semibold">{item.title}</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-600">{item.description}</p>
        </li>
      ))
    }
  </ul>
</section>

<!-- ── Cómo trabajamos ──────────────────────────────────────────────────── -->
<section id="metodo" class="scroll-mt-24 border-y border-ink-100 bg-ink-50 py-20 sm:py-24">
  <div class="container-page">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold sm:text-4xl">{strings.approach.title}</h2>
      <p class="mt-4 text-lg text-ink-600">{strings.approach.subtitle}</p>
    </div>

    <ol class="mt-12 grid gap-8 sm:grid-cols-3">
      {
        strings.approach.items.map((item, i) => (
          <li>
            <span class="text-sm font-bold tabular-nums text-brand-600">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-lg font-semibold">{item.title}</h3>
            <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-600">{item.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- ── Nosotros ─────────────────────────────────────────────────────────── -->
<section id="nosotros" class="container-page scroll-mt-24 py-20 sm:py-24">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
    <h2 class="text-3xl font-bold sm:text-4xl">{strings.about.title}</h2>
    <div class="space-y-5 text-lg leading-relaxed text-ink-600">
      {strings.about.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<!-- ── Contacto ─────────────────────────────────────────────────────────── -->
<section id="contacto" class="container-page scroll-mt-24 pb-4">
  <div class="rounded-3xl bg-ink-900 px-7 py-14 sm:px-14">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">{strings.contact.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-300">{strings.contact.subtitle}</p>
    </div>

    <dl class="mt-10 grid gap-8 sm:grid-cols-3">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-widest text-ink-400">
          {strings.contact.emailLabel}
        </dt>
        <dd class="mt-2">
          <a
            href={`mailto:${site.email.general}`}
            class="text-[0.95rem] font-medium text-white underline decoration-ink-600 underline-offset-4 hover:decoration-white"
          >
            {site.email.general}
          </a>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-widest text-ink-400">
          {strings.contact.phoneLabel}
        </dt>
        <dd class="mt-2 text-[0.95rem] font-medium text-white">{site.phone}</dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-widest text-ink-400">
          {strings.contact.locationLabel}
        </dt>
        <dd class="mt-2 text-[0.95rem] font-medium text-white">
          {site.address.city}, {site.address.country}
        </dd>
      </div>
    </dl>

    <a href={`mailto:${site.email.general}`} class="btn mt-10 bg-white text-ink-900 hover:bg-ink-100">
      {strings.contact.cta}
    </a>
  </div>
</section>
