---
import HeroVisual from './HeroVisual.astro';
import { site, stack } from '../config/site';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

/* Un icono por servicio, en el mismo orden que ui.ts. Trazos SVG inline:
   sin peticiones extra ni dependencias de iconos. */
const serviceIcons = [
  'M3 3v18h18M7 15l3.5-4 3 3L21 7', // analítica: línea de tendencia
  'M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6l2.1 2.1m0-12.8l-2.1 2.1M7.7 16.3l-2.1 2.1M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0', // automatización
  'M8 6l-5 6 5 6M16 6l5 6-5 6M13.5 4l-3 16', // desarrollo
  'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z', // Microsoft
];
---

<!-- ── Hero ─────────────────────────────────────────────────────────────── -->
<section class="relative overflow-hidden">
  <!-- Dos halos muy difusos en lugar de una banda de color plana: dan
       profundidad sin marcar un borde entre secciones. -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute -top-40 right-[-10%] h-[38rem] w-[38rem] rounded-full opacity-60 blur-3xl"
      style="background: radial-gradient(circle, var(--ci-brand-soft), transparent 65%);"
    >
    </div>
    <div
      class="absolute -left-40 top-40 h-[30rem] w-[30rem] rounded-full opacity-50 blur-3xl"
      style="background: radial-gradient(circle, var(--ci-canvas-soft), transparent 70%);"
    >
    </div>
  </div>

  <div class="container-page py-20 sm:py-24 lg:py-28">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div class="reveal">
        <p class="eyebrow" style="color: var(--ci-brand-ink);">{strings.hero.eyebrow}</p>

        <h1 class="mt-5 text-[2.6rem] leading-[1.06] tracking-[-0.03em] font-bold sm:text-[3.25rem] lg:text-display">
          {strings.hero.title}
        </h1>

        <p class="mt-6 max-w-xl text-lead text-body">{strings.hero.subtitle}</p>

        <!-- La frase que resuelve la tensión entre especializarse y no
             encasillarse: destacada porque es el diferenciador, no un adorno. -->
        <p
          class="mt-6 max-w-xl rounded-r-xl py-2.5 pl-4 pr-3 text-base font-semibold text-strong"
          style="border-left: 3px solid var(--ci-brand); background: var(--ci-brand-soft);"
        >
          {strings.hero.principle}
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#contacto" class="btn-primary">{strings.hero.ctaPrimary}</a>
          <a href="#servicios" class="btn-secondary">{strings.hero.ctaSecondary}</a>
        </div>
      </div>

      <div class="reveal lg:pl-4">
        <HeroVisual />
      </div>
    </div>
  </div>
</section>

<!-- ── Franja de tecnología ─────────────────────────────────────────────── -->
<section
  class="border-y border-line bg-canvas-soft py-9"
  aria-label={strings.stack.label}
>
  <div class="container-page space-y-4 reveal">
    {
      (
        [
          { label: strings.stack.deep, items: stack.deep, primary: true },
          { label: strings.stack.broad, items: stack.broad, primary: false },
        ] as const
      ).map((row) => (
        <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:gap-6">
          <h2 class="eyebrow w-52 shrink-0">{row.label}</h2>
          <ul class="flex flex-wrap gap-2">
            {row.items.map((tech) => (
              <li
                class="rounded-lg px-3 py-1.5 text-sm font-semibold"
                style={
                  row.primary
                    ? 'background: var(--ci-brand-soft); color: var(--ci-brand-ink); border: 1px solid var(--ci-brand-line);'
                    : 'background: var(--ci-card); color: var(--ci-body); border: 1px solid var(--ci-line);'
                }
              >
                {tech}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<!-- ── Servicios ────────────────────────────────────────────────────────── -->
<section id="servicios" class="container-page scroll-mt-24 py-20 sm:py-28">
  <div class="max-w-2xl reveal">
    <p class="eyebrow">{strings.nav.services}</p>
    <h2 class="mt-3 text-title">{strings.services.title}</h2>
    <p class="mt-4 text-lead text-body">{strings.services.subtitle}</p>
  </div>

  <ul class="mt-14 grid gap-5 sm:grid-cols-2">
    {
      strings.services.items.map((item, i) => (
        <li class="surface surface-hover reveal rounded-2xl p-7">
          <span
            class="flex h-11 w-11 items-center justify-center rounded-xl"
            style="background: var(--ci-brand-soft); color: var(--ci-brand-ink); border: 1px solid var(--ci-brand-line);"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={serviceIcons[i]} />
            </svg>
          </span>
          <h3 class="mt-5 text-lg font-semibold">{item.title}</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-body">{item.description}</p>
        </li>
      ))
    }
  </ul>
</section>

<!-- ── Cómo trabajamos ──────────────────────────────────────────────────── -->
<section id="metodo" class="scroll-mt-24 border-y border-line bg-canvas-soft py-20 sm:py-28">
  <div class="container-page">
    <div class="max-w-2xl reveal">
      <p class="eyebrow">{strings.nav.approach}</p>
      <h2 class="mt-3 text-title">{strings.approach.title}</h2>
      <p class="mt-4 text-lead text-body">{strings.approach.subtitle}</p>
    </div>

    <ol class="mt-14 grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        strings.approach.items.map((item, i) => (
          <li class="reveal">
            <span
              class="block text-3xl font-bold tabular-nums"
              style="color: var(--ci-brand); opacity: 0.35;"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-lg font-semibold">{item.title}</h3>
            <p class="mt-2.5 text-[0.95rem] leading-relaxed text-body">{item.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- ── Nosotros ─────────────────────────────────────────────────────────── -->
<section id="nosotros" class="container-page scroll-mt-24 py-20 sm:py-28">
  <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
    <div class="reveal">
      <p class="eyebrow">{strings.nav.about}</p>
      <h2 class="mt-3 text-title">{strings.about.title}</h2>
    </div>
    <div class="reveal space-y-5 text-lead text-body">
      {strings.about.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<!-- ── Contacto ─────────────────────────────────────────────────────────── -->
<section id="contacto" class="container-page scroll-mt-24 pb-24">
  <div
    class="surface reveal relative overflow-hidden rounded-3xl px-7 py-14 shadow-deep sm:px-14"
  >
    <div
      class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full opacity-70 blur-3xl"
      style="background: radial-gradient(circle, var(--ci-brand-soft), transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="relative max-w-2xl">
      <h2 class="text-title">{strings.contact.title}</h2>
      <p class="mt-4 text-lead text-body">{strings.contact.subtitle}</p>
    </div>

    <dl class="relative mt-10 grid gap-8 sm:grid-cols-3">
      <div>
        <dt class="eyebrow">{strings.contact.emailLabel}</dt>
        <dd class="mt-2">
          <a
            href={`mailto:${site.email.general}`}
            class="text-[0.95rem] font-semibold underline decoration-line underline-offset-4 transition-colors hover:decoration-current"
            style="color: var(--ci-brand-ink);"
          >
            {site.email.general}
          </a>
        </dd>
      </div>
      <div>
        <dt class="eyebrow">{strings.contact.phoneLabel}</dt>
        <dd class="mt-2 text-[0.95rem] font-semibold text-strong">{site.phone}</dd>
      </div>
      <div>
        <dt class="eyebrow">{strings.contact.locationLabel}</dt>
        <dd class="mt-2 text-[0.95rem] font-semibold text-strong">
          {site.address.city}, {site.address.country}
        </dd>
      </div>
    </dl>

    <a href={`mailto:${site.email.general}`} class="btn-primary relative mt-10">
      {strings.contact.cta}
    </a>
  </div>
</section>
