---
import Hero from './Hero.astro';
import SystemSection from './SystemSection.astro';
import MvpSection from './MvpSection.astro';
import { site } from '../config/site';
import { t } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

const home = localizedPath('home', locale);
const base = home === '/' ? '' : home;
---

<Hero locale={locale} />

<SystemSection locale={locale} />

<MvpSection locale={locale} />

<!-- ── Servicios: un índice, no una cuadrícula de tarjetas ──────────────── -->
<section id="servicios" class="border-b border-line">
  <div class="container-page py-24 sm:py-32">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">{strings.services.eyebrow}</p>
      <h2 class="h-title mt-4">{strings.services.title}</h2>
    </div>

    <ul class="mt-14 border-t border-line-strong">
      {
        strings.services.items.map((item, i) => (
          <li class="row reveal group grid gap-3 border-b border-line py-8 sm:grid-cols-[7rem_1fr] sm:gap-10 lg:grid-cols-[7rem_1.1fr_1.4fr] lg:items-baseline" style={`--d:${i * 0.06}s`}>
            <span class="font-mono text-[0.72rem] uppercase tracking-[0.09em] text-muted transition-colors group-hover:text-signal-ink">
              {String(i + 1).padStart(2, '0')} / {item.tag}
            </span>
            <h3 class="text-[1.45rem] leading-[1.15] tracking-[-0.025em] sm:text-[1.7rem]">{item.title}</h3>
            <p class="text-[0.98rem] leading-relaxed text-body sm:col-start-2 lg:col-start-3">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- ── Método ───────────────────────────────────────────────────────────── -->
<section id="metodo" class="border-b border-line bg-canvas-soft">
  <div class="container-page py-24 sm:py-32">
    <div class="grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <div class="reveal lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">{strings.approach.eyebrow}</p>
        <h2 class="h-title mt-4">{strings.approach.title}</h2>
      </div>

      <ol class="grid gap-0">
        {
          strings.approach.items.map((item, i) => (
            <li class="reveal grid gap-4 border-t border-line-strong py-9 first:border-t-0 first:pt-0 sm:grid-cols-[4.5rem_1fr]" style={`--d:${i * 0.06}s`}>
              <span class="font-serif text-[3rem] italic leading-none text-brand-ink">{i + 1}</span>
              <div>
                <h3 class="text-[1.35rem] leading-snug tracking-[-0.02em]">{item.title}</h3>
                <p class="mt-3 max-w-xl text-[1rem] leading-relaxed text-body">{item.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<!-- ── Nosotros ─────────────────────────────────────────────────────────── -->
<section id="nosotros" class="border-b border-line">
  <div class="container-page py-24 sm:py-32">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <div class="reveal">
        <p class="eyebrow">{strings.about.eyebrow}</p>
        <h2 class="h-title mt-4">{strings.about.title}</h2>
      </div>
      <div class="reveal space-y-6 text-lead text-body" style="--d:.08s">
        {strings.about.body.map((paragraph) => <p>{paragraph}</p>)}
        <blockquote class="mt-10 border-l-2 border-signal pl-6 font-serif text-[1.9rem] italic leading-[1.2] text-strong sm:text-[2.3rem]">
          {strings.about.quote}
        </blockquote>
      </div>
    </div>
  </div>
</section>

<!-- ── Contacto ─────────────────────────────────────────────────────────── -->
<section id="contacto" class="theme-ink bg-canvas">
  <div class="container-page py-24 sm:py-32">
    <div class="grid gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-24">
      <div class="reveal">
        <h2 class="h-display text-strong">{strings.contact.title}</h2>
        <p class="mt-7 max-w-lg text-lead text-body">{strings.contact.subtitle}</p>
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href={`mailto:${site.email.general}`} class="btn-primary px-6 py-3.5">
            {strings.contact.cta}
            <span aria-hidden="true">→</span>
          </a>
          <a
            href={`${base}/#mvp`}
            class="font-mono text-[0.78rem] uppercase tracking-[0.06em] text-muted underline decoration-line-strong underline-offset-[6px] transition-colors hover:text-strong hover:decoration-signal"
          >
            {strings.contact.mvpHint}
          </a>
        </div>
      </div>

      <dl class="reveal grid gap-0 self-end border-t border-line-strong" style="--d:.1s">
        <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[8rem_1fr] sm:items-baseline">
          <dt class="eyebrow">{strings.contact.emailLabel}</dt>
          <dd>
            <a
              href={`mailto:${site.email.general}`}
              class="break-all text-[1.02rem] text-strong underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-signal"
            >
              {site.email.general}
            </a>
          </dd>
        </div>
        <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[8rem_1fr] sm:items-baseline">
          <dt class="eyebrow">{strings.contact.phoneLabel}</dt>
          <dd class="text-[1.02rem] text-strong">{site.phone}</dd>
        </div>
        <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[8rem_1fr] sm:items-baseline">
          <dt class="eyebrow">{strings.contact.locationLabel}</dt>
          <dd class="text-[1.02rem] text-strong">{site.address.city}, {site.address.country}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
