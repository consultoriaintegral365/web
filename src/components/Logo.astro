---
interface Props {
  /** 'dark' para fondos claros (cabecera), 'light' para fondos oscuros (pie). */
  variant?: 'dark' | 'light';
  class?: string;
}

const { variant = 'dark', class: className = '' } = Astro.props;

const wordColor = variant === 'light' ? 'text-white' : 'text-ink-900';
const subColor = variant === 'light' ? 'text-ink-300' : 'text-ink-500';
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    class="h-9 w-9 shrink-0"
    viewBox="0 0 40 40"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <rect width="40" height="40" rx="9" fill="currentColor" class="text-brand-600" />
    <path
      d="M12.6 15.2v9.6M20 11.4v17.2M27.4 18.1v6.7"
      stroke="white"
      stroke-width="3.1"
      stroke-linecap="round"
    />
  </svg>
  <span class="flex flex-col leading-none">
    <span class={`text-[0.95rem] font-bold tracking-tight ${wordColor}`}>
      Consultoría Integral
    </span>
    <span class={`text-[0.7rem] font-semibold uppercase tracking-[0.22em] ${subColor}`}>
      365
    </span>
  </span>
</span>
