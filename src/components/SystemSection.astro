---
/**
 * «El sistema»: la tesis de la consultora. Automatizar, medir y construir no
 * son tres líneas de negocio sino una cadena: lo que un proceso produce se mide,
 * y lo que se mide indica qué construir. En escritorio, el panel de la derecha
 * se queda fijo y cambia de escena según el paso que se esté leyendo; en móvil,
 * cada paso lleva su escena debajo.
 */
import Scene from './Scene.astro';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale).system;
---

<section id="sistema" class="border-b border-line">
  <div class="container-page py-24 sm:py-32">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">{s.eyebrow}</p>
      <h2 class="h-title mt-4">{s.title}</h2>
      <p class="mt-6 max-w-2xl text-lead text-body">{s.subtitle}</p>
    </div>

    <div class="mt-16 grid gap-14 lg:mt-24 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20" data-system>
      <ol class="grid gap-16 lg:gap-0">
        {
          s.stages.map((st, i) => (
            <li class="stage lg:flex lg:min-h-[64vh] lg:items-center" data-stage={i}>
              <div>
                <p class="mono-label flex items-center gap-3">
                  <span class="text-signal-ink">{String(i + 1).padStart(2, '0')}</span>
                  <span class="h-px w-6 bg-line-strong"></span>
                  {st.label}
                </p>
                <h3 class="mt-5 text-[1.65rem] leading-[1.12] tracking-[-0.03em] sm:text-[2rem]">
                  {st.title}
                </h3>
                <p class="mt-5 max-w-lg text-[1.02rem] leading-relaxed text-body">{st.body}</p>
                <ul class="mt-7 grid gap-3 text-[0.95rem] text-strong">
                  {st.points.map((pt) => (
                    <li class="flex gap-3">
                      <span class="mt-[0.55em] h-px w-3.5 shrink-0 bg-signal" aria-hidden="true" />
                      {pt}
                    </li>
                  ))}
                </ul>

                <div class="frame mt-9 h-[21rem] p-4 lg:hidden">
                  <Scene kind={i as 0 | 1 | 2} locale={locale} />
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="hidden lg:block">
        <div class="sticky top-28">
          <div class="frame relative h-[33rem]" data-frame data-stage="0">
            <div class="flex border-b border-line">
              {
                s.stages.map((st, i) => (
                  <span class="tab mono-label flex-1 px-4 py-3" data-tab={i}>
                    {String(i + 1).padStart(2, '0')} {st.label}
                  </span>
                ))
              }
            </div>
            <div class="relative h-[calc(100%-2.9rem)]">
              {
                s.stages.map((_, i) => (
                  <div class="layer absolute inset-0 p-8" data-layer={i}>
                    <Scene kind={i as 0 | 1 | 2} locale={locale} />
                  </div>
                ))
              }
            </div>
          </div>
          <p class="mono-label mt-3 text-right">{t(locale).pipeline.caption}</p>
        </div>
      </div>
    </div>

    <div class="reveal mt-20 flex flex-col gap-5 border-t border-line pt-9 sm:flex-row sm:items-center lg:mt-28">
      <svg
        class="spin h-11 w-11 shrink-0 text-signal"
        viewBox="0 0 48 48"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M24 6a18 18 0 1 1-17 12"></path>
        <path d="M6 8v10h10"></path>
      </svg>
      <p class="max-w-2xl text-[1.05rem] leading-relaxed text-body">
        <span class="mono-label mr-3 text-signal-ink">{s.loopLabel}</span>{s.loopText}
      </p>
    </div>
  </div>
</section>

<style>
  .frame {
    border: 1px solid var(--ci-line-strong);
    border-radius: 12px;
    background: var(--ci-canvas-soft);
    overflow: hidden;
  }
  .layer {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }
  [data-frame][data-stage='0'] [data-layer='0'],
  [data-frame][data-stage='1'] [data-layer='1'],
  [data-frame][data-stage='2'] [data-layer='2'] {
    opacity: 1;
    transform: none;
  }
  .tab {
    position: relative;
    transition: color 0.3s ease;
  }
  .tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--ci-signal);
    transform: scaleX(0);
    transition: transform 0.4s ease;
  }
  [data-frame][data-stage='0'] [data-tab='0'],
  [data-frame][data-stage='1'] [data-tab='1'],
  [data-frame][data-stage='2'] [data-tab='2'] {
    color: var(--ci-strong);
  }
  [data-frame][data-stage='0'] [data-tab='0']::after,
  [data-frame][data-stage='1'] [data-tab='1']::after,
  [data-frame][data-stage='2'] [data-tab='2']::after {
    transform: scaleX(1);
  }

  /* En escritorio, los pasos que no se están leyendo se atenúan. */
  @media (min-width: 1024px) {
    :global(html.js) .stage {
      opacity: 0.32;
      transition: opacity 0.5s ease;
    }
    :global(html.js) .stage.is-active {
      opacity: 1;
    }
  }

  .spin {
    animation: spin 14s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  /* Marca el paso que cruza el centro de la ventana y cambia la escena. Si no
     hay IntersectionObserver o JavaScript, todos los pasos se ven completos. */
  const root = document.querySelector('[data-system]');
  if (root && 'IntersectionObserver' in window) {
    const frame = root.querySelector<HTMLElement>('[data-frame]');
    const stages = Array.from(root.querySelectorAll<HTMLElement>('.stage'));
    const set = (i: number) => {
      if (frame) frame.dataset.stage = String(i);
      stages.forEach((el, n) => el.classList.toggle('is-active', n === i));
    };
    set(0);
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) set(Number((e.target as HTMLElement).dataset.stage));
        });
      },
      { rootMargin: '-42% 0px -42% 0px', threshold: 0 }
    );
    stages.forEach((el) => io.observe(el));
  }
</script>
