---
import Logo from './Logo.astro';
import { site } from '../config/site';
import { localizedPath } from '../i18n/utils';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const year = new Date().getFullYear();

const home = localizedPath('home', locale);
const base = home === '/' ? '' : home;
---

<footer class="mt-24 bg-ink-900 text-ink-300">
  <div class="container-page py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <Logo variant="light" />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-400">
          {strings.footer.tagline}
        </p>
        {
          site.social.linkedin && (
            <a
              href={site.social.linkedin}
              class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-ink-300 transition-colors hover:text-white"
              rel="noopener noreferrer"
              target="_blank"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.4 8.65 21 11.1 21 14.3V21h-4v-5.9c0-1.4-.03-3.2-1.95-3.2-1.96 0-2.26 1.53-2.26 3.1V21H9z" />
              </svg>
              LinkedIn
            </a>
          )
        }
      </div>

      <div>
        <h2 class="text-xs font-semibold uppercase tracking-widest text-white">
          {strings.footer.company}
        </h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a href={`${base}/#servicios`} class="transition-colors hover:text-white">
              {strings.nav.services}
            </a>
          </li>
          <li>
            <a href={`${base}/#nosotros`} class="transition-colors hover:text-white">
              {strings.nav.about}
            </a>
          </li>
          <li>
            <a href={`${base}/#contacto`} class="transition-colors hover:text-white">
              {strings.nav.contact}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email.general}`} class="transition-colors hover:text-white">
              {site.email.general}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-xs font-semibold uppercase tracking-widest text-white">
          {strings.footer.legal}
        </h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a href={localizedPath('terms', locale)} class="transition-colors hover:text-white">
              {strings.footer.terms}
            </a>
          </li>
          <li>
            <a href={localizedPath('privacy', locale)} class="transition-colors hover:text-white">
              {strings.footer.privacy}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-ink-800 pt-6 text-xs text-ink-400 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.legalName}. {strings.footer.rights}</p>
      <p>{strings.footer.taxIdLabel} {site.taxId} &middot; {site.address.city}, {site.address.country}</p>
    </div>
  </div>
</footer>
