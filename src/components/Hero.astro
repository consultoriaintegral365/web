---
import ExampleDemo from './ExampleDemo.astro';
import Button from './ui/Button.astro';
import { t } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const h = strings.hero;

/* Las palabras del titular entran una a una, desde una máscara. Es la única
   entrada animada de la portada; es CSS puro y corre en el primer pintado. */
const before = h.titleBefore.split(' ');
const after = h.titleAccent.split(' ');

const home = localizedPath('home', locale);
const base = home === '/' ? '' : home;
---

<section class="relative isolate overflow-hidden border-b border-line bg-canvas" data-hero>
  <div class="container-page pb-16 pt-14 sm:pt-20 lg:pb-24 lg:pt-24">
    <div class="grid items-center gap-14 lg:grid-cols-[0.86fr_1.14fr] lg:gap-12">
      <div>
        <a
          href={`${base}/#mvp`}
          class="rise inline-flex min-h-11 items-center gap-2.5 rounded-full border border-line-strong bg-card pl-3.5 pr-4 text-sm font-medium text-body transition-colors hover:border-signal hover:text-strong"
        >
          <span class="inline-flex h-2 w-2 rounded-full bg-signal" style="box-shadow:0 0 8px var(--t-ai)" aria-hidden="true"></span>
          {h.badge}
        </a>

        <h1 class="h-display mt-7 text-strong">
          <span class="block">
            {
              before.map((w, i) => (
                <span class="wm"><span class="w" style={`--i:${i}`}>{w}&nbsp;</span></span>
              ))
            }
          </span>
          <span class="block">
            {
              after.map((w, i) => (
                <span class="wm"><span class="w" style={`--i:${before.length + i}`}>{w}&nbsp;</span></span>
              ))
            }
          </span>
        </h1>

        <p class="rise mt-7 max-w-xl text-lead text-body" style="--d:.45s">
          {h.subtitle}
          <span class="mt-4 block font-medium text-strong">{h.principle}</span>
        </p>

        <div class="rise mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center" style="--d:.55s">
          <Button href={`${base}/#mvp`} size="lg" data-open-mvp>{h.ctaPrimary}</Button>
          <Button href={`${base}/#camino`} size="lg" variant="secondary">{h.ctaSecondary}</Button>
        </div>

      </div>

      <div class="rise lg:pl-2" style="--d:.35s">
        <ExampleDemo locale={locale} />
      </div>
    </div>
  </div>

</section>

<style>
  /* Máscara por palabra: el titular «sube» desde una línea invisible. */
  .wm {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: 0.02em 0 0.14em;
    margin-bottom: -0.14em;
  }
  .w {
    display: inline-block;
    transform: translateY(105%);
    animation: rise 0.9s cubic-bezier(0.2, 0.75, 0.2, 1) forwards;
    animation-delay: calc(0.08s + var(--i) * 0.07s);
  }
  @keyframes rise {
    to {
      transform: none;
    }
  }
</style>
