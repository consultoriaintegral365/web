---
/**
 * «Solicita tu MVP»: la oferta central de la web. Un MVP acotado y sin costo
 * cuyo propósito es hacer tangible la viabilidad del proyecto antes de que el
 * cliente invierta. La pieza visual es un recibo con total «S/ 0»: convierte
 * «sin costo» en algo que se puede leer línea por línea, en vez de repetir un
 * eslogan. El recibo usa colores fijos de papel, no los del tema, para que se
 * lea como un objeto físico sobre la banda oscura.
 */
import { site } from '../config/site';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale).mvp;

const mailto = `mailto:${site.email.general}?subject=${encodeURIComponent(m.mailSubject)}&body=${encodeURIComponent(m.mailBody)}`;
---

<section id="mvp" class="theme-ink relative isolate overflow-hidden border-y border-line bg-canvas">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="bg-grid absolute inset-0" style="opacity:.32;"></div>
  </div>

  <div class="container-page py-24 sm:py-32">
    <div class="grid items-center gap-16 lg:grid-cols-[1.12fr_0.88fr] lg:gap-20">
      <div>
        <div class="reveal flex flex-wrap items-center gap-3">
          <p class="eyebrow">{m.eyebrow}</p>
          <span
            class="inline-flex items-center gap-2 rounded-md border border-signal bg-signal-soft px-2.5 py-1 font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em] text-signal-ink"
          >
            <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6.5 5 9.5 10 3"></path></svg>
            {m.badge}
          </span>
        </div>

        <h2 class="h-display reveal mt-6 text-strong" style="--d:.08s">
          {m.titleBefore}
          <span class="accent block">{m.titleAccent}</span>
        </h2>

        <p class="reveal mt-7 max-w-xl text-lead text-body" style="--d:.16s">{m.lead}</p>

        <div class="reveal mt-12" style="--d:.22s">
          <p class="mono-label">{m.stepsTitle}</p>
          <ol class="mt-5 grid gap-x-8 gap-y-6 sm:grid-cols-2">
            {
              m.steps.map((step, i) => (
                <li class="border-t border-line-strong pt-4">
                  <span class="font-mono text-xs text-signal-ink">{String(i + 1).padStart(2, '0')}</span>
                  <p class="mt-1.5 text-[0.98rem] font-medium text-strong">{step}</p>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="reveal mt-12 flex flex-col gap-4 sm:flex-row sm:items-center" style="--d:.3s">
          <a href={mailto} class="btn-primary px-7 py-4 text-[0.95rem]">
            {m.cta}
            <span aria-hidden="true">→</span>
          </a>
          <p class="max-w-sm text-sm leading-relaxed text-muted">{m.note}</p>
        </div>
      </div>

      <div class="print reveal flex justify-center lg:justify-end" style="--d:.1s">
        <div class="wrap">
          <article class="receipt" aria-label={m.receiptTitle}>
            <header class="rc-head">
              <span class="rc-brand">c<span class="rc-i">ı</span>365</span>
              <span class="rc-meta">{site.legalName}<br />{site.address.city}, {site.address.country}</span>
            </header>

            <p class="rc-title">{m.receiptTitle}</p>

            <ul class="rc-lines">
              {
                m.receiptLines.map(([label, value], i) => (
                  <li class="line" style={`--i:${i}`}>
                    <span>{label}</span>
                    <i aria-hidden="true"></i>
                    <b>{value}</b>
                  </li>
                ))
              }
            </ul>

            <div class="rc-total line" style="--i:3">
              <span>{m.totalLabel}</span>
              <strong>{m.totalValue}</strong>
            </div>

            <div class="rc-code" aria-hidden="true"></div>
            <p class="rc-foot">{site.shortName} · MVP · {m.badge}</p>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .wrap {
    width: 100%;
    max-width: 25rem;
    filter: drop-shadow(0 24px 40px rgb(0 0 0 / 0.45));
  }
  .receipt {
    --paper: #f6f4ef;
    --ink: #0c0f14;
    --faint: #6b6f78;
    position: relative;
    padding: 1.7rem 1.6rem 2.6rem;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    transform: rotate(-1.4deg);
    /* Borde inferior dentado, como papel arrancado de la impresora. */
    -webkit-mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 16px 100%;
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 16px 100%;
    padding-bottom: 3rem;
  }
  .rc-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px dashed #b9b4a8;
  }
  .rc-brand {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .rc-i {
    position: relative;
    display: inline-block;
  }
  .rc-i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.2em;
    width: 0.17em;
    height: 0.17em;
    border-radius: 50%;
    background: #0e9f88;
    transform: translateX(-50%);
  }
  .rc-meta {
    font-size: 0.62rem;
    line-height: 1.5;
    text-align: right;
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .rc-title {
    margin: 1.2rem 0 0.9rem;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .rc-lines {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rc-lines li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.8rem;
  }
  .rc-lines i {
    flex: 1;
    border-bottom: 1px dotted #a8a396;
    transform: translateY(-3px);
  }
  .rc-lines b {
    font-weight: 600;
  }
  .rc-total {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 1.4rem;
    padding-top: 1.1rem;
    border-top: 1px dashed #b9b4a8;
  }
  .rc-total span {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-bottom: 0.55rem;
  }
  .rc-total strong {
    font-size: 3.6rem;
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.06em;
    background: linear-gradient(transparent 82%, #2dd4bf 82%);
    padding: 0 0.1em;
  }
  .rc-code {
    height: 2.1rem;
    margin-top: 1.6rem;
    background: repeating-linear-gradient(
      90deg,
      var(--ink) 0 2px,
      transparent 2px 4px,
      var(--ink) 4px 5px,
      transparent 5px 9px,
      var(--ink) 9px 12px,
      transparent 12px 14px
    );
    opacity: 0.85;
  }
  .rc-foot {
    margin: 0.6rem 0 0;
    text-align: center;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  /* El recibo «se imprime»: baja de arriba abajo y cada línea aparece en orden. */
  :global(html.js) .print .receipt {
    clip-path: inset(0 0 100% 0);
  }
  :global(html.js) .print .line {
    opacity: 0;
    transform: translateY(-6px);
  }
  :global(html.js) .print.is-visible .receipt {
    animation: printout 1.5s cubic-bezier(0.3, 0.7, 0.2, 1) 0.2s forwards;
  }
  :global(html.js) .print.is-visible .line {
    animation: lineIn 0.45s ease forwards;
    animation-delay: calc(0.6s + var(--i) * 0.28s);
  }
  @keyframes printout {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes lineIn {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 420px) {
    .rc-total strong {
      font-size: 3rem;
    }
  }
</style>
