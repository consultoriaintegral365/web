---
/**
 * Etiqueta pequeña sobre un titular o dato. Una sola, en frase normal (sin
 * mayúsculas ni monoespaciada): la monoespaciada queda para datos reales.
 */
interface Props {
  as?: 'p' | 'span' | 'div';
  class?: string;
}

const { as: Tag = 'p', class: className } = Astro.props;
---

<Tag class:list={['label', className]}><slot /></Tag>
