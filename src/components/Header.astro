---
import Logo from './Logo.astro';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { localizedPath } from '../i18n/utils';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import type { RouteKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  minimal?: boolean;
}

const { locale, routeKey, minimal = false } = Astro.props;
const strings = t(locale);

const home = localizedPath('home', locale);
/* Los anclajes apuntan siempre a la home del idioma actual, de modo que la
   navegación también funciona desde las páginas legales. */
const base = home === '/' ? '' : home;
const links = [
  { label: strings.nav.system, href: `${base}/#sistema` },
  { label: strings.nav.services, href: `${base}/#servicios` },
  { label: strings.nav.approach, href: `${base}/#metodo` },
  { label: strings.nav.about, href: `${base}/#nosotros` },
];
const mvpHref = `${base}/#mvp`;
const contactHref = `${base}/#contacto`;
---

<!-- Sobre el hero (siempre oscuro) la cabecera se vuelve «tinta»; al pasarlo,
     vuelve al tema elegido. El script está en Base.astro. -->
<header
  data-header
  class="sticky top-0 z-40 border-b border-line backdrop-blur-xl transition-colors duration-300"
  style="background: color-mix(in srgb, var(--ci-canvas) 78%, transparent);"
>
  <div class="container-page flex h-16 items-center justify-between gap-3">
    <a href={home} class="shrink-0" aria-label={`${strings.nav.home} — Consultoría Integral 365`}>
      <Logo />
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      {!minimal && <nav aria-label={strings.nav.home} class="mr-3 hidden lg:block">
        <ul class="flex items-center gap-7">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[0.84rem] text-body transition-colors hover:text-strong"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>}

      <LangSwitcher locale={locale} routeKey={routeKey} />
      <ThemeToggle locale={locale} />

      {!minimal && (
      <a href={mvpHref} class="btn-primary hidden px-4 py-2 sm:inline-flex">
        {strings.nav.mvp}
      </a>
      )}

      <!-- Menú móvil: <details> nativo, sin JavaScript. -->
      {!minimal && <details class="relative lg:hidden">
        <summary
          class="surface flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg text-body [&::-webkit-details-marker]:hidden"
          aria-label={strings.nav.menu}
        >
          <svg
            class="h-[18px] w-[18px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <ul class="surface absolute right-0 top-11 w-60 rounded-xl p-2 shadow-lift">
          {
            [...links, { label: strings.nav.mvp, href: mvpHref }, { label: strings.nav.contact, href: contactHref }].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block rounded-lg px-3 py-2 text-sm text-body transition-colors hover:bg-canvas-soft hover:text-strong"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>}
    </div>
  </div>
</header>
