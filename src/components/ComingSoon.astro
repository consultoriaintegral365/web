---
/**
 * Aviso «Muy pronto»: ocupa el lugar de la portada mientras la nueva web no se
 * publica. Se activa con la variable de build PUBLIC_COMING_SOON=1 y se
 * desactiva quitándola; la web completa sigue intacta en el código.
 *
 * Intención: despertar curiosidad sin prometer nada que no se pueda cumplir. No
 * hay cuenta atrás ni fecha inventada; el contacto sigue disponible para quien
 * quiera ver lo nuevo antes que nadie.
 */
import { site, whatsappUrl } from '../config/site';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const s = strings.soon;

const before = s.titleBefore.split(' ');
const accent = s.titleAccent.split(' ');
const mailto = `mailto:${site.email.general}?subject=${encodeURIComponent(s.mailSubject)}&body=${encodeURIComponent(s.mailBody)}`;
const wa = whatsappUrl(s.whatsappMessage);
/* Anchos distintos y fijos: sugieren un trabajo a medias sin dar cifras. */
const widths = [100, 100, 64, 28];
---

<section class="theme-ink relative isolate overflow-hidden bg-canvas">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0"
      style="background: radial-gradient(640px circle at 72% 30%, color-mix(in srgb, var(--ci-brand) 15%, transparent), transparent 62%);"
    >
    </div>
  </div>

  <div class="container-page flex min-h-[calc(100svh-4rem)] items-center py-16 sm:py-20">
    <div class="grid w-full items-center gap-14 lg:grid-cols-[1.12fr_0.88fr] lg:gap-16">
      <div>
        <p class="label flex items-center gap-2.5">
          <span class="relative flex h-1.5 w-1.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-signal opacity-60"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-signal"></span>
          </span>
          {s.eyebrow}
        </p>

        <h1 class="h-display mt-7 text-strong">
          <span class="block">
            {before.map((w, i) => <span class="wm"><span class="w" style={`--i:${i}`}>{w}&nbsp;</span></span>)}
          </span>
          <span class="block">
            {
              accent.map((w, i) => (
                <span class="wm"><span class="w" style={`--i:${before.length + i}`}>{w}&nbsp;</span></span>
              ))
            }
          </span>
        </h1>

        <p class="reveal mt-7 max-w-xl text-lead text-body" style="--d:.5s">{s.subtitle}</p>

        <div class="reveal mt-9 flex flex-wrap items-center gap-3" style="--d:.6s">
          <a href={mailto} class="btn-primary whitespace-nowrap px-7 py-4 text-[0.95rem]">
            {s.cta}
            <span aria-hidden="true">→</span>
          </a>
          <a href={wa} target="_blank" rel="noopener" aria-label={s.whatsappLabel} class="wa btn-secondary">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
            </svg>
            <span class="tip" role="tooltip">{s.whatsappLabel}</span>
          </a>
        </div>

        <p class="reveal mt-9 flex items-start gap-3 font-mono text-[0.78rem] leading-relaxed text-muted" style="--d:.7s">
          <span class="mt-px text-signal" aria-hidden="true">↳</span>
          {s.hint}
        </p>
      </div>

      <div class="reveal" style="--d:.35s" aria-hidden="true">
        <div class="panel">
          <div class="bar">
            <span class="mono">flujo.ci365</span>
            <span class="status"><i class="dot"></i>{s.status}</span>
          </div>
          <ul class="rows">
            {
              s.rows.map((label, i) => (
                <li>
                  <span class="lb">{label}</span>
                  <span class="track"><i class={`fill ${i > 1 ? 'busy' : ''}`} style={`--w:${widths[i]}%;--i:${i}`}></i></span>
                </li>
              ))
            }
          </ul>
          <div class="foot mono"><span>ci365 &gt; <b class="cursor">_</b></span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-line">
    <ul
      class="container-page flex flex-wrap items-center gap-x-6 gap-y-2 py-4 font-mono text-[0.7rem] uppercase tracking-[0.07em] text-muted"
    >
      <li>{strings.facts.since} {site.foundedYear}</li>
      <li class="hidden text-line-strong sm:block" aria-hidden="true">/</li>
      <li>{strings.facts.registered}</li>
      <li class="hidden text-line-strong sm:block" aria-hidden="true">/</li>
      <li>{strings.facts.location}</li>
      <li class="hidden text-line-strong sm:block" aria-hidden="true">/</li>
      <li class="normal-case tracking-normal">
        <a href={`mailto:${site.email.general}`} class="underline decoration-line-strong underline-offset-4 transition-colors hover:text-strong hover:decoration-signal">{site.email.general}</a>
      </li>
    </ul>
  </div>
</section>

<style>
  /* Titular: las palabras suben desde una máscara (CSS puro, sin esperar a scripts). */
  .wm {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: 0.02em 0 0.14em;
    margin-bottom: -0.14em;
  }
  .w {
    display: inline-block;
    transform: translateY(105%);
    animation: rise 0.9s cubic-bezier(0.2, 0.75, 0.2, 1) forwards;
    animation-delay: calc(0.08s + var(--i) * 0.07s);
  }
  @keyframes rise {
    to {
      transform: none;
    }
  }

  /* Botón de WhatsApp: cuadrado, con globo al pasar el ratón o enfocar. */
  .wa {
    position: relative;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0;
    color: var(--ci-signal);
  }
  .wa:hover,
  .wa:focus-visible {
    border-color: var(--ci-signal);
    color: var(--ci-signal-ink);
  }
  .tip {
    position: absolute;
    bottom: calc(100% + 0.6rem);
    left: 50%;
    transform: translate(-50%, 4px);
    padding: 0.4rem 0.7rem;
    border-radius: 6px;
    border: 1px solid var(--ci-line-strong);
    background: var(--ci-card);
    color: var(--ci-strong);
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.16s ease, transform 0.16s ease;
  }
  .wa:hover .tip,
  .wa:focus-visible .tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* Panel de estado: decorativo, sin cifras. */
  .panel {
    border: 1px solid var(--ci-line-strong);
    border-radius: 12px;
    background: color-mix(in srgb, var(--ci-card) 88%, transparent);
    box-shadow: var(--ci-shadow-lg);
    overflow: hidden;
  }
  .bar,
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.1rem;
    font-size: 0.72rem;
    color: var(--ci-muted);
  }
  .bar {
    border-bottom: 1px solid var(--ci-line);
  }
  .foot {
    border-top: 1px solid var(--ci-line);
  }
  .mono {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    color: var(--ci-signal-ink);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ci-signal);
    animation: blink 1.6s ease-in-out infinite;
  }
  .rows {
    margin: 0;
    padding: 0.4rem 1.1rem;
    list-style: none;
  }
  .rows li {
    display: grid;
    grid-template-columns: 6.2rem 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--ci-line);
  }
  .rows li:last-child {
    border-bottom: 0;
  }
  .lb {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ci-strong);
  }
  .track {
    position: relative;
    height: 6px;
    border-radius: 3px;
    background: var(--ci-line);
    overflow: hidden;
  }
  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    border-radius: 3px;
    background: var(--ci-line-strong);
    transform: scaleX(0);
    transform-origin: left;
    animation: grow 1.3s cubic-bezier(0.3, 0.7, 0.2, 1) forwards;
    animation-delay: calc(0.5s + var(--i) * 0.18s);
  }
  .fill.busy {
    background: linear-gradient(90deg, var(--ci-brand), var(--ci-signal), var(--ci-brand));
    background-size: 200% 100%;
    animation:
      grow 1.3s cubic-bezier(0.3, 0.7, 0.2, 1) forwards,
      sweep 2.4s linear infinite;
    animation-delay: calc(0.5s + var(--i) * 0.18s), 0s;
  }
  .cursor {
    color: var(--ci-signal-ink);
    animation: blink 1s steps(2, start) infinite;
  }
  @keyframes grow {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes sweep {
    to {
      background-position: -200% 0;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
</style>
