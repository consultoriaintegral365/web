---
import { LOCALE_META } from '../i18n/config';
import { alternates } from '../i18n/utils';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import type { RouteKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  class?: string;
}

const { locale, routeKey, class: className = '' } = Astro.props;
const strings = t(locale);

/* Enlaces reales a la página equivalente en cada idioma: sin JavaScript,
   rastreable por buscadores y funciona con el navegador sin scripts. */
const options = alternates(routeKey);

/* Una pagina publicada en un solo idioma no necesita selector: mostrar un
   unico boton sugeriria que hay alternativas donde no las hay. */
const showSwitcher = options.length > 1;
---

{showSwitcher && (
<nav aria-label={strings.nav.language} class={className}>
  <ul class="flex items-center gap-0.5 rounded-lg p-0.5" style="background: var(--ci-canvas-soft); border: 1px solid var(--ci-line);">
    {
      options.map(({ locale: l, path }) => {
        const isCurrent = l === locale;
        return (
          <li>
            <a
              href={path}
              hreflang={LOCALE_META[l].htmlLang}
              lang={LOCALE_META[l].htmlLang}
              aria-current={isCurrent ? 'true' : undefined}
              title={LOCALE_META[l].nativeName}
              class:list={[
                'block rounded-[0.3rem] px-2.5 py-1 text-xs font-semibold transition-colors',
                isCurrent
                  ? 'bg-card text-strong shadow-soft'
                  : 'text-muted hover:text-strong',
              ]}
            >
              <span class="sr-only">{strings.nav.changeLanguage}: </span>
              {LOCALE_META[l].label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
)}
