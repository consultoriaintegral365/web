---
/**
 * «Arma tu MVP»: formulario en 4 pasos dentro de un <dialog> nativo (foco
 * atrapado, Escape y accesibilidad gratis). A la derecha, un ticket se va
 * completando con lo que el visitante elige; al enviar, se convierte en su
 * ticket con número. Es la parte lúdica de la web: progreso, una recompensa
 * tangible y cero adornos.
 *
 * Mejora progresiva: si no hay endpoint configurado (PUBLIC_LEADS_ENDPOINT) el
 * componente no se pinta y el botón del MVP sigue siendo un enlace mailto.
 */
import { site, whatsappUrl } from '../config/site';
import { t } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale).mvp;
const f = m.form;
const enabled = Boolean(import.meta.env.PUBLIC_LEADS_ENDPOINT);
const privacy = localizedPath('privacy', locale);
const wa = whatsappUrl();
const total = f.steps.length;
---

{
  enabled && (
    <dialog
      id="mvp-dialog"
      class="theme-ink"
      aria-labelledby="mvp-dialog-title"
      data-total={total}
      data-wa={wa}
      data-wa-msg={m.whatsappMessage}
      data-email={site.email.general}
    >
      <div class="shell">
        <header class="top">
          <div>
            <p id="mvp-dialog-title" class="ttl">{f.title}</p>
            <p class="count">
              {f.progress} <b data-n>1</b> {f.of} {total}
            </p>
          </div>
          <button type="button" class="x" data-close aria-label={f.close}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </header>
        <div class="bar" aria-hidden="true"><span data-bar></span></div>

        <div class="grid">
          <form novalidate data-form>
            <!-- Paso 1 -->
            <fieldset data-step="0">
              <legend>{f.steps[0].title}</legend>
              <div class="opts">
                {f.steps[0].options!.map(([id, label, hint]) => (
                  <label class="opt">
                    <input type="radio" name="need" value={id} data-label={label} />
                    <span><b>{label}</b><i>{hint}</i></span>
                  </label>
                ))}
              </div>
              <p class="err" data-err role="alert" data-required={f.steps[3].required}></p>
            </fieldset>

            <!-- Paso 2 -->
            <fieldset data-step="1" hidden>
              <legend>{f.steps[1].title}</legend>
              <p class="lab">{f.steps[1].sizeLabel}</p>
              <div class="chips">
                {f.steps[1].sizes!.map((s) => (
                  <label class="chip"><input type="radio" name="size" value={s} /><span>{s}</span></label>
                ))}
              </div>
              <p class="lab">{f.steps[1].urgencyLabel}</p>
              <div class="chips">
                {f.steps[1].urgencies!.map((s) => (
                  <label class="chip"><input type="radio" name="urgency" value={s} /><span>{s}</span></label>
                ))}
              </div>
              <p class="err" data-err role="alert" data-required={f.steps[3].required}></p>
            </fieldset>

            <!-- Paso 3 -->
            <fieldset data-step="2" hidden>
              <legend>{f.steps[2].title}</legend>
              <textarea name="message" rows="6" maxlength="1500" placeholder={f.steps[2].placeholder} data-short={f.steps[2].tooShort}></textarea>
              <p class="err" data-err role="alert"></p>
            </fieldset>

            <!-- Paso 4 -->
            <fieldset data-step="3" hidden>
              <legend>{f.steps[3].title}</legend>
              <div class="fields">
                <label>{f.steps[3].name}<input name="name" autocomplete="name" maxlength="120" required /></label>
                <label>{f.steps[3].email}<input name="email" type="email" autocomplete="email" maxlength="160" required /></label>
                <label>{f.steps[3].company}<input name="company" autocomplete="organization" maxlength="160" required /></label>
                <label>{f.steps[3].role}<input name="role" autocomplete="organization-title" maxlength="120" /></label>
                <label class="wide">{f.steps[3].phone}<input name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
                <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
              </div>
              <label class="consent">
                <input type="checkbox" name="consent" />
                <span>{f.steps[3].consentBefore} <a href={privacy} target="_blank" rel="noopener">{f.steps[3].consentLink}</a>.</span>
              </label>
              <p class="err" data-err role="alert" data-required={f.steps[3].required} data-email-msg={f.steps[3].invalidEmail} data-consent-msg={f.steps[3].needConsent}></p>
            </fieldset>

            <p class="err fail" data-fail role="alert" hidden>{f.error}</p>

            <div class="nav">
              <button type="button" class="btn-secondary" data-back hidden>{f.back}</button>
              <button type="button" class="btn-primary" data-next data-sending={f.sending} data-submit={f.submit}>{f.next}</button>
            </div>
          </form>

          <!-- Estado final: el mismo ticket, ya con número -->
          <div class="done" data-done hidden>
            <p class="ttl">{f.ticket.title}</p>
            <p class="demo" data-demo hidden>{f.ticket.demo}</p>
            <p class="msg">{f.ticket.done} <b data-done-email></b> {f.ticket.next}</p>
            <div class="nav">
              <a class="btn-primary" data-wa-link href="#" target="_blank" rel="noopener" data-track="whatsapp_click">{m.whatsappCta}</a>
              <button type="button" class="btn-secondary" data-close>{f.ticket.close}</button>
            </div>
          </div>

          <aside class="paper" aria-hidden="true">
            <article class="receipt">
              <header class="rc-head">
                <span class="rc-brand">c<span class="rc-i">ı</span>365</span>
                <span class="rc-meta">{f.ticket.title}</span>
              </header>
              <ul class="rc-lines">
                <li><span>{f.ticket.lines[0]}</span><i></i><b data-t-ticket>MVP-······</b></li>
                <li><span>{f.ticket.lines[1]}</span><i></i><b data-t-need>—</b></li>
                <li><span>{f.ticket.lines[2]}</span><i></i><b data-t-company>—</b></li>
                <li><span>{f.ticket.lines[3]}</span><i></i><b>{f.ticket.cost}</b></li>
              </ul>
              <div class="rc-code"></div>
            </article>
          </aside>
        </div>
      </div>
    </dialog>
  )
}

<style>
  dialog {
    /* El reset de Tailwind pone margin:0 en todo y descentra los modales. */
    margin: auto;
    width: min(58rem, calc(100% - 1.5rem));
    max-height: min(92vh, 46rem);
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--t-blue) 45%, var(--ci-line-strong));
    border-radius: 14px;
    background: var(--ci-canvas);
    color: var(--ci-body);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.55), 0 0 60px -20px color-mix(in srgb, var(--t-blue) 70%, transparent);
    overflow: auto;
  }
  dialog[open] {
    animation: pop 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  dialog::backdrop {
    background: rgb(5 6 9 / 0.72);
    backdrop-filter: blur(4px);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.985);
    }
  }
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }

  .shell {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1.2rem 1.4rem 0.9rem;
  }
  .ttl {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ci-strong);
  }
  .count {
    margin: 0.3rem 0 0;
    font-size: 0.875rem;
    color: var(--ci-muted);
  }
  .count b {
    color: var(--ci-signal-ink);
    font-weight: 500;
  }
  .x {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--ci-line-strong);
    border-radius: 8px;
    background: transparent;
    color: var(--ci-body);
    cursor: pointer;
  }
  .x:hover {
    color: var(--ci-strong);
    border-color: var(--ci-muted);
  }
  .bar {
    height: 2px;
    background: var(--ci-line);
  }
  .bar span {
    display: block;
    height: 100%;
    width: 25%;
    background: var(--ci-signal);
    transition: width 0.45s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .grid {
    display: grid;
    gap: 1.6rem;
    padding: 1.4rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 2.2rem;
      padding: 1.8rem 1.8rem 1.6rem;
    }
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
    animation: step 0.35s ease;
  }
  fieldset[hidden] {
    display: none;
  }
  @keyframes step {
    from {
      opacity: 0;
      transform: translateX(10px);
    }
  }
  legend {
    padding: 0;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--ci-strong);
  }
  .lab {
    margin: 1.1rem 0 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ci-muted);
  }

  input[type='radio'] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .opts {
    display: grid;
    gap: 0.6rem;
  }
  .opt {
    display: block;
    cursor: pointer;
  }
  .opt span {
    display: grid;
    gap: 0.1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--ci-line-strong);
    border-radius: 10px;
    transition: border-color 0.18s ease, background 0.18s ease;
  }
  .opt b {
    font-weight: 500;
    color: var(--ci-strong);
  }
  .opt i {
    font-style: normal;
    font-size: 0.82rem;
    color: var(--ci-muted);
  }
  .opt:hover span {
    border-color: var(--ci-muted);
  }
  .opt input:checked + span {
    border-color: var(--ci-brand);
    background: var(--ci-brand-soft);
  }
  .opt input:focus-visible + span,
  .chip input:focus-visible + span {
    outline: 2px solid var(--ci-brand-ink);
    outline-offset: 2px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    cursor: pointer;
  }
  .chip span {
    display: inline-block;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--ci-line-strong);
    border-radius: 8px;
    font-size: 0.9rem;
    transition: border-color 0.18s ease, background 0.18s ease;
  }
  .chip:hover span {
    border-color: var(--ci-muted);
  }
  .chip input:checked + span {
    border-color: var(--ci-brand);
    background: var(--ci-brand-soft);
    color: var(--ci-strong);
  }

  textarea,
  .fields input:not(.hp) {
    width: 100%;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--ci-line-strong);
    border-radius: 8px;
    background: var(--ci-card);
    color: var(--ci-strong);
    font: inherit;
    font-size: 0.95rem;
  }
  textarea {
    resize: vertical;
    min-height: 8rem;
  }
  textarea:focus,
  .fields input:focus {
    outline: 2px solid var(--ci-brand-ink);
    outline-offset: 1px;
    border-color: transparent;
  }
  .fields {
    display: grid;
    gap: 0.8rem;
    grid-template-columns: 1fr 1fr;
  }
  .fields label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.78rem;
    color: var(--ci-muted);
  }
  .fields .wide {
    grid-column: 1 / -1;
  }
  @media (max-width: 520px) {
    .fields {
      grid-template-columns: 1fr;
    }
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .consent {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    margin-top: 1rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ci-body);
  }
  .consent input {
    margin-top: 0.2rem;
    accent-color: var(--ci-brand);
  }
  .consent a {
    color: var(--ci-brand-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .err {
    min-height: 1.2rem;
    margin: 0.7rem 0 0;
    font-size: 0.82rem;
    color: var(--ci-danger);
  }
  .nav {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.2rem;
    flex-wrap: wrap;
  }
  .nav button[hidden] {
    display: none;
  }
  .done {
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }
  .done[hidden],
  form[hidden] {
    display: none;
  }
  .done .ttl {
    font-size: 1.5rem;
    letter-spacing: -0.03em;
  }
  .demo {
    margin: 0.8rem 0 0.2rem;
    padding: 0.65rem 0.85rem;
    border: 1px dashed var(--ci-warn);
    border-radius: 8px;
    background: color-mix(in srgb, var(--ci-warn) 8%, transparent);
    color: var(--ci-warn);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .demo[hidden] {
    display: none;
  }
  .msg {
    margin: 0.6rem 0 0;
    line-height: 1.6;
  }
  .msg b {
    color: var(--ci-strong);
    font-weight: 500;
    overflow-wrap: anywhere;
    white-space: nowrap;
  }
  @media (max-width: 420px) {
    .msg b {
      white-space: normal;
    }
  }

  /* Ticket */
  .paper {
    display: none;
  }
  @media (min-width: 760px) {
    .paper {
      display: block;
      align-self: start;
      filter: drop-shadow(0 18px 30px rgb(0 0 0 / 0.4));
    }
  }
  .receipt {
    padding: 1.3rem 1.2rem 2.4rem;
    transform: rotate(1.2deg);
    -webkit-mask: conic-gradient(from -45deg at bottom, transparent, black 1deg 89deg, transparent 90deg) 50% / 14px 100%;
    mask: conic-gradient(from -45deg at bottom, transparent, black 1deg 89deg, transparent 90deg) 50% / 14px 100%;
  }
  .rc-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.9rem;
    border-bottom: 1px dashed var(--ci-ticket-dash);
  }
  .rc-brand {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .rc-i {
    position: relative;
    display: inline-block;
  }
  .rc-i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.2em;
    width: 0.17em;
    height: 0.17em;
    border-radius: 50%;
    background: var(--ci-ticket-mark);
    transform: translateX(-50%);
  }
  .rc-meta {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase; /* audit-ok: recibo */
    color: var(--faint);
  }
  .rc-lines {
    display: grid;
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .rc-lines li {
    display: flex;
    gap: 0.45rem;
    align-items: baseline;
    font-size: 0.74rem;
  }
  .rc-lines i {
    flex: 1;
    border-bottom: 1px dotted var(--ci-ticket-dot);
    transform: translateY(-3px);
    min-width: 0.5rem;
  }
  .rc-lines b {
    font-weight: 600;
    text-align: right;
    max-width: 55%;
    overflow-wrap: anywhere;
  }
  .rc-lines b.fill {
    animation: ink 0.5s ease;
  }
  @keyframes ink {
    from {
      background: var(--ci-ticket-hilite);
    }
  }
  .rc-code {
    height: 1.8rem;
    margin-top: 1.3rem;
    background: repeating-linear-gradient(90deg, var(--ink) 0 2px, transparent 2px 4px, var(--ink) 4px 5px, transparent 5px 9px, var(--ink) 9px 12px, transparent 12px 14px);
    opacity: 0.85;
  }
</style>

<script>
  import { track, attribution, endpoint } from '../lib/track';

  const dlg = document.getElementById('mvp-dialog') as HTMLDialogElement | null;
  const openers = document.querySelectorAll<HTMLElement>('[data-open-mvp]');

  if (dlg && endpoint) {
    const total = Number(dlg.dataset.total);
    const form = dlg.querySelector<HTMLFormElement>('[data-form]')!;
    const steps = Array.from(dlg.querySelectorAll<HTMLFieldSetElement>('[data-step]'));
    const bar = dlg.querySelector<HTMLElement>('[data-bar]')!;
    const nEl = dlg.querySelector<HTMLElement>('[data-n]')!;
    const back = dlg.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = dlg.querySelector<HTMLButtonElement>('[data-next]')!;
    const fail = dlg.querySelector<HTMLElement>('[data-fail]')!;
    const done = dlg.querySelector<HTMLElement>('[data-done]')!;
    const tTicket = dlg.querySelector<HTMLElement>('[data-t-ticket]')!;
    const tNeed = dlg.querySelector<HTMLElement>('[data-t-need]')!;
    const tCompany = dlg.querySelector<HTMLElement>('[data-t-company]')!;
    const nextLabel = next.textContent ?? '';
    let step = 0;
    let openedAt = 0;
    let sent = false;

    const val = (name: string) =>
      (form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() ?? '';
    const checked = (name: string) =>
      form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);

    const flash = (el: HTMLElement, text: string) => {
      el.textContent = text;
      el.classList.remove('fill');
      void el.offsetWidth;
      el.classList.add('fill');
    };

    const show = (n: number) => {
      step = n;
      steps.forEach((s, i) => (s.hidden = i !== n));
      nEl.textContent = String(n + 1);
      bar.style.width = `${((n + 1) / total) * 100}%`;
      back.hidden = n === 0;
      next.textContent = n === total - 1 ? next.dataset.submit ?? nextLabel : nextLabel;
      fail.hidden = true;
      steps[n].querySelectorAll<HTMLElement>('[data-err]').forEach((e) => (e.textContent = ''));
    };

    const error = (msg: string) => {
      const el = steps[step].querySelector<HTMLElement>('[data-err]');
      if (el) el.textContent = msg;
      return false;
    };

    const valid = (): boolean => {
      const e = steps[step].querySelector<HTMLElement>('[data-err]');
      if (step === 0) return checked('need') ? true : error(e?.dataset.required ?? '');
      if (step === 1) return checked('size') && checked('urgency') ? true : error(e?.dataset.required ?? '');
      if (step === 2) return val('message').length >= 20 ? true : error(steps[2].querySelector<HTMLElement>('textarea')?.dataset.short ?? '');
      const req = e?.dataset.required ?? '';
      if (!val('name') || !val('company') || !val('email')) return error(req);
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(val('email'))) return error(e?.dataset.emailMsg ?? '');
      if (!(form.elements.namedItem('consent') as HTMLInputElement).checked) return error(e?.dataset.consentMsg ?? '');
      return true;
    };

    /* El ticket se completa mientras eliges. */
    form.addEventListener('change', (ev) => {
      const t = ev.target as HTMLInputElement;
      if (t.name === 'need') flash(tNeed, t.dataset.label ?? '—');
    });
    form.addEventListener('input', (ev) => {
      if ((ev.target as HTMLInputElement).name === 'company') tCompany.textContent = val('company') || '—';
    });

    const open = () => {
      if (!dlg.open) dlg.showModal();
      openedAt = Date.now();
      show(0);
      track('form_open');
    };
    openers.forEach((el) =>
      el.addEventListener('click', (ev) => {
        ev.preventDefault();
        open();
      })
    );

    const close = () => {
      if (!sent) track('form_close', { step: step + 1 });
      dlg.close();
    };
    dlg.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', close));
    dlg.addEventListener('click', (ev) => {
      if (ev.target === dlg) close();
    });

    back.addEventListener('click', () => show(Math.max(0, step - 1)));

    const submit = async () => {
      next.disabled = true;
      next.textContent = next.dataset.sending ?? '…';
      fail.hidden = true;
      const a = attribution();
      const payload = {
        need: val('need') || checked('need')?.value,
        size: checked('size')?.value,
        urgency: checked('urgency')?.value,
        message: val('message'),
        name: val('name'),
        email: val('email'),
        company: val('company'),
        role: val('role'),
        phone: val('phone'),
        website: val('website'),
        consent: true,
        lang: document.documentElement.lang,
        page: location.pathname,
        elapsed: Date.now() - openedAt,
        ...a,
      };
      try {
        const res = await fetch(endpoint + '/lead', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error(String(res.status));
        const out = (await res.json()) as { ticket?: string; demo?: boolean };
        sent = true;
        /* El backend de pruebas de staging avisa de que no guardó nada. */
        dlg.querySelector<HTMLElement>('[data-demo]')!.hidden = !out.demo;
        track('form_submit_ok');
        tTicket.textContent = out.ticket ?? 'MVP';
        tCompany.textContent = payload.company || '—';
        dlg.querySelector<HTMLElement>('[data-done-email]')!.textContent = payload.email;
        const wa = dlg.querySelector<HTMLAnchorElement>('[data-wa-link]')!;
        wa.href = `${dlg.dataset.wa}${encodeURIComponent(`${dlg.dataset.waMsg} ${out.ticket ?? ''}`.trim())}`;
        form.hidden = true;
        done.hidden = false;
        bar.style.width = '100%';
        flash(tTicket, tTicket.textContent);
      } catch {
        track('form_submit_error');
        fail.hidden = false;
        next.disabled = false;
        next.textContent = next.dataset.submit ?? nextLabel;
      }
    };

    next.addEventListener('click', () => {
      if (!valid()) return;
      track('form_step', { step: step + 1 });
      if (step < total - 1) show(step + 1);
      else void submit();
    });

    /* Enter en un campo avanza, igual que el botón. */
    form.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' && (ev.target as HTMLElement).tagName !== 'TEXTAREA') {
        ev.preventDefault();
        next.click();
      }
    });
  }
</script>
