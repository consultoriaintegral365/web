---
import Base from "../layouts/Base.astro";
import HomePage from "../components/HomePage.astro";
import { t } from "../i18n/ui";

const locale = "es" as const;
const strings = t(locale);

/* PUBLIC_COMING_SOON=1 muestra el aviso «Muy pronto» en lugar de la portada. */
const comingSoon = import.meta.env.PUBLIC_COMING_SOON === "1";
---

<Base
  locale={locale}
  routeKey="home"
  title={comingSoon ? strings.soon.metaTitle : strings.meta.homeTitle}
  description={comingSoon ? strings.soon.metaDescription : strings.meta.homeDescription}
  minimal={comingSoon}
>
  <HomePage locale={locale} />
</Base>
