---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { LOCALE_META } from '../i18n/config';
import { alternates, defaultAlternateLocale, localizedPath } from '../i18n/utils';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import type { RouteKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  /** Cabecera y pie reducidos (sin enlaces a secciones), para el aviso «Muy pronto». */
  minimal?: boolean;
}

const { locale, routeKey, title, description, minimal = false } = Astro.props;
const strings = t(locale);
const meta = LOCALE_META[locale];

const canonical = new URL(localizedPath(routeKey, locale), Astro.site).href;
const langAlternates = alternates(routeKey).map(({ locale: l, path }) => ({
  hrefLang: LOCALE_META[l].htmlLang,
  href: new URL(path, Astro.site).href,
}));
const xDefault = new URL(localizedPath(routeKey, defaultAlternateLocale(routeKey)), Astro.site).href;

// El título de la home ya incluye la marca; el resto la añade como sufijo.
const fullTitle = routeKey === 'home' ? title : `${title} — ${site.name}`;

/** Datos estructurados: ayudan a Google y sirven de señal de legitimidad
 *  en revisiones manuales (p. ej. verificación de editor de Microsoft). */
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  alternateName: site.shortName,
  url: site.url,
  email: site.email.general,
  telephone: site.phone,
  foundingDate: String(site.foundedYear),
  description: strings.meta.homeDescription,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.countryCode,
  },
  ...(site.social.linkedin ? { sameAs: [site.social.linkedin] } : {}),
};
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />

    <script is:inline>
      /* Resuelve el tema antes del primer pintado para que no haya parpadeo,
         y marca html.js para que las animaciones de aparicion solo existan
         cuando hay JavaScript: sin el, el contenido se ve igualmente. */
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var theme = 'light';
        try {
          theme =
            localStorage.getItem('ci-theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch (e) {}
        root.dataset.theme = theme;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      langAlternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hrefLang} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f4ef" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0c10" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-on-brand"
    >
      {strings.nav.skipToContent}
    </a>

    <Header locale={locale} routeKey={routeKey} minimal={minimal} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer locale={locale} minimal={minimal} />

    <script is:inline>
      /* Una sola aparicion por elemento; se deja de observar tras revelarlo. */
      (function () {
        var targets = document.querySelectorAll('.reveal');
        if (!targets.length) return;

        function revealAll() {
          targets.forEach(function (el) { el.classList.add('is-visible'); });
        }

        /* Red de seguridad: el CSS oculta .reveal en cuanto hay JavaScript, asi
           que cualquier fallo del observador dejaria la pagina en blanco de
           forma permanente. Pase lo que pase, a los 2 s se muestra todo. */
        setTimeout(revealAll, 2000);

        if (!('IntersectionObserver' in window) ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          revealAll();
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
        );
        targets.forEach(function (el) { io.observe(el); });
      })();
    </script>

    <script is:inline>
      /* Interaccion ligera, siempre opcional:
         1) sobre el hero (siempre oscuro) la cabecera se vuelve tinta;
         2) la luz del hero y los elementos .spot siguen al puntero.
         Sin JavaScript, la pagina funciona igual. */
      (function () {
        var header = document.querySelector('[data-header]');
        var hero = document.querySelector('[data-hero]');
        if (header && hero) {
          var ticking = false;
          var update = function () {
            ticking = false;
            /* Mientras el hero siga bajo la cabecera, esta se ve «tinta». */
            header.classList.toggle('theme-ink', hero.getBoundingClientRect().bottom > header.offsetHeight);
          };
          var onScroll = function () {
            if (!ticking) { ticking = true; requestAnimationFrame(update); }
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
          update();
        }

        var finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!finePointer || reduce) return;
        var raf = 0, px = 0, py = 0, area = null;
        document.addEventListener('pointermove', function (ev) {
          px = ev.clientX; py = ev.clientY;
          area = ev.target && ev.target.closest ? ev.target.closest('[data-spot-area],.spot') : null;
          if (raf) return;
          raf = requestAnimationFrame(function () {
            raf = 0;
            if (!area) return;
            var r = area.getBoundingClientRect();
            area.style.setProperty('--mx', (px - r.left) + 'px');
            area.style.setProperty('--my', (py - r.top) + 'px');
          });
        }, { passive: true });
      })();
    </script>
  </body>
</html>
